#!/usr/bin/env sh

. "$(dirname -- "$0")/../scripts/git-hooks/common.sh"

load_shell_env
cd "$(repo_root)"

STAGED=$(git diff --cached --name-only --diff-filter=ACMR || true)
[ -z "$STAGED" ] && exit 0

PACKAGES=$(echo "$STAGED" | sh scripts/affected-workspaces.sh)
[ -z "$PACKAGES" ] && exit 0

echo "pre-commit: affected workspaces:"
echo "$PACKAGES" | sed 's/^/  - /'

run_lint_for_packages "$PACKAGES"
