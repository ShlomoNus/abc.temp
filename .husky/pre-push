#!/usr/bin/env sh

. "$(dirname -- "$0")/../scripts/git-hooks/common.sh"

load_shell_env
cd "$(repo_root)"

zero=$(git hash-object --stdin </dev/null | tr '[0-9a-f]' '0')
files=""

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base HEAD origin/main 2>/dev/null || git merge-base HEAD origin/master 2>/dev/null || true)
    if [ -n "$base" ]; then
      files="$files
$(git diff --name-only "$base..$local_sha")"
    else
      files="$files
$(git diff --name-only "$local_sha~1..$local_sha" 2>/dev/null || git show --name-only --pretty=format: "$local_sha")"
    fi
  else
    files="$files
$(git diff --name-only "$remote_sha..$local_sha")"
  fi
done

[ -z "$files" ] && files=$(git diff --name-only @{u}..HEAD 2>/dev/null || true)
[ -z "$files" ] && exit 0

PACKAGES=$(echo "$files" | sort -u | sh scripts/affected-workspaces.sh)
[ -z "$PACKAGES" ] && exit 0

echo "pre-push: affected workspaces:"
echo "$PACKAGES" | sed 's/^/  - /'

run_push_for_packages "$PACKAGES"
