{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": ".",
    "outDir": "dist",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "composite": true,
    "types": [
      "node"
    ]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": [
    "dist",
    "node_modules"
  ]
}