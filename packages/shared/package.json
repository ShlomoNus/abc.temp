{
  "name": "@earthquake-reports/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "rimraf dist tsconfig.build.tsbuildinfo && pnpm run build:types && pnpm run build:js",
    "build:js": "tsx scripts/build.ts --prod",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.build.json"
  }
}