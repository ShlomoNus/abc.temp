{
  "name": "mod.earthquake-reports",
  "version": "1.0.0",
  "private": true,
  "description": "Earthquake reports monorepo — ETL, AI, and search APIs",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:etl": "pnpm --filter @earthquake-reports/etl-lambda dev",
    "dev:ai": "pnpm --filter @earthquake-reports/ai-lambda dev",
    "dev:search": "pnpm --filter @earthquake-reports/search-api dev",
    "build": "pnpm --filter @earthquake-reports/shared build && pnpm --filter \"./apps/*\" build",
    "build:etl": "pnpm --filter @earthquake-reports/shared build && pnpm --filter @earthquake-reports/etl-lambda build",
    "build:ai": "pnpm --filter @earthquake-reports/shared build && pnpm --filter @earthquake-reports/ai-lambda build",
    "build:search": "pnpm --filter @earthquake-reports/shared build && pnpm --filter @earthquake-reports/search-api build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "docker:start": "docker compose up -d",
    "docker:stop": "docker compose stop",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose down && docker compose up -d",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:clean": "docker compose down -v --remove-orphans"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.17.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@esbuild-plugins/tsconfig-paths": "^0.1.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.0.6",
    "@types/node": "^25.5.0",
    "esbuild": "^0.27.4",
    "eslint": "^10.0.3",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.5.0",
    "globals": "^17.4.0",
    "jiti": "^2.7.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "type-fest": "^5.4.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  },
  "packageManager": "pnpm@10.12.1"
}
