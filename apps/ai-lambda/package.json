{
  "name": "@earthquake-reports/ai-lambda",
  "version": "1.0.0",
  "description": "AI summarize Lambda for earthquake reports",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "tsx src/index.ts",
    "build": "rimraf dist lambdaOutput && pnpm run build:types && pnpm run build:js",
    "build:js": "tsx scripts/build.ts --prod",
    "build:dev": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "package:lambda": "tsx scripts/package-lambda.ts"
  },
  "dependencies": {
    "@codegenie/serverless-express": "^5.0.0",
    "@earthquake-reports/shared": "workspace:*",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "envalid": "^8.1.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "jszip": "^3.10.1"
  }
}
