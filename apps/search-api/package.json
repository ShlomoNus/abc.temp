{
  "name": "@earthquake-reports/search-api",
  "version": "1.0.0",
  "description": "Search and summary API for earthquake reports",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "tsx src/index.ts",
    "build": "pnpm run build:types && pnpm run build:js",
    "build:js": "tsx scripts/build.ts --prod",
    "build:dev": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "docker:start": "docker compose up -d",
    "docker:stop": "docker compose stop",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose down && docker compose up -d",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:clean": "docker compose down -v --remove-orphans"
  },
  "dependencies": {
    "@earthquake-reports/shared": "workspace:*",
    "@elastic/elasticsearch": "^9.4.0",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "envalid": "^8.1.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@esbuild-plugins/tsconfig-paths": "^0.1.2",
    "@repo/eslint-config": "workspace:*",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/swagger-ui-express": "^4.1.8",
    "esbuild": "^0.27.4",
    "tsx": "^4.21.0",
    "type-fest": "^5.4.4",
    "typescript": "^5.9.3"
  }
}
