# Local environment variables (tracked)
AWS_REGION=il-central-1

LOG_LEVEL=info
LOG_PRETTY=true
NODE_ENV=development
S3_EARTHQUAKE_REPORTS_SOURCE=s3://s3-content-earthquake-dev
S3_INIT_LOAD_PREFIX=init-load/
S3_INCOMING_FILES_PREFIX=incoming-files/
AI_LAMBDA_NAME=
ES_INDEX_NAME=earthquake-documents

