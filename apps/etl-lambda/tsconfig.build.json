{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "composite": true,
    "rootDir": "src",
    "outDir": "dist/types",
    "paths": {
      "@/*": ["./src/*"],
      "@earthquake-reports/shared": ["../../packages/shared/dist/index"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/test-server.ts"
  ],
  "references": [{ "path": "../../packages/shared" }]
}
