{
  "name": "@earthquake-reports/etl-lambda",
  "version": "1.0.0",
  "description": "Archive ETL for earthquake reports",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:server": "tsx watch src/test-server.ts",
    "dev": "tsx watch src/test-server.ts",
    "build": "rimraf dist lambdaOutput && pnpm run build:types && pnpm run build:js",
    "build:js": "tsx scripts/build.ts --prod",
    "build:dev": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "package:lambda": "tsx scripts/package-lambda.ts"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1044.0",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@codegenie/serverless-express": "^4.17.1",
    "@earthquake-reports/shared": "workspace:*",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "envalid": "^8.1.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/swagger-ui-express": "^4.1.8",
    "jszip": "^3.10.1"
  }
}
